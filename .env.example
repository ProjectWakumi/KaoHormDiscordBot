# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
DISCORD_TOKEN=ใส่โทเคนบอทที่นี่

# (ไม่บังคับ) ใส่ ID เซิร์ฟเวอร์ทดลอง เพื่อให้ Slash Commands อัปเดตทันทีตอนพัฒนา
DEV_GUILD_ID=

# (ไม่บังคับ) ห้อง/ข้อความที่มีรูป Banner สำหรับ Embed ของ Security Guard
BANNER_CHANNEL_ID=
BANNER_MESSAGE_ID=

# (ไม่บังคับ) URL ของ version.json บน GitHub สำหรับสถานะบอท
# VERSION_URL=https://raw.githubusercontent.com/ProjectWakumi/KaoHormDiscordBot/main/version.json
